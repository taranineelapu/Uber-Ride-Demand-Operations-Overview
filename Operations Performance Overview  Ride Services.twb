      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0k34q0e0f2af831d5s7461qaq5fr].[usr:Calculation_0821670238887944:qk]&quot;' value='Daily Bookings' />
          <alias key='&quot;[federated.0k34q0e0f2af831d5s7461qaq5fr].[win:usr:Calculation_0821670238887944:qk:4]&quot;' value='7-Day Moving Average' />
        </aliases>
      </column>
      <column datatype='string' datatype-customized='true' name='[Booking Status]' role='dimension' type='nominal' />
      <column datatype='real' datatype-customized='true' name='[Booking Value]' role='dimension' type='ordinal' />
      <column caption='Booking Date' datatype='date' name='[Calculation_0821670231302144]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE([Date])' />
      </column>
      <column caption='Booking Hour' datatype='integer' name='[Calculation_0821670233423873]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;hour&apos;, [Time])' />
      </column>
      <column caption='Day Type' datatype='string' name='[Calculation_0821670234742786]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;weekday&apos;, [Calculation_0821670231302144], &apos;monday&apos;) &gt;= 6&#13;&#10;THEN &quot;Weekend&quot;&#13;&#10;ELSE &quot;Weekday&quot;&#13;&#10;END' />
      </column>
      <column caption='Completed Flag' datatype='integer' name='[Calculation_0821670235598851]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;Completed&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Driver Cancellation Flag' datatype='integer' name='[Calculation_0821670235672580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;Cancelled by Driver&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Customer Cancellation Flag' datatype='integer' name='[Calculation_0821670235774981]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;Cancelled by Customer&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='No Driver Flag' datatype='integer' name='[Calculation_0821670235942918]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;No Driver Found&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Incomplete Flag' datatype='integer' name='[Calculation_0821670236082183]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Booking Status] = &quot;Incomplete&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Total Bookings' datatype='integer' name='[Calculation_0821670238887944]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([Booking ID])' />
      </column>
      <column caption='Completed Rides' datatype='integer' name='[Calculation_0821670238978057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0821670235598851])' />
      </column>
      <column caption='Completion Rate' datatype='real' default-format='p0.00%' name='[Calculation_0821670239055882]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0821670235598851]) / COUNT([Booking ID])' />
